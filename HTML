<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mystery Image Reveal</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            background-color: #f0f2f5;
            margin: 0;
        }

        h1 {
            color: #333;
        }

        /* Container holds the image and the grid */
        .image-container {
            position: relative;
            width: 400px;
            height: 400px;
            /* Replace this URL with your custom picture link */
            background-image: url('https://picsum.photos');
            background-size: cover;
            border: 4px solid #fff;
            box-shadow: 0 4px 10px rgba(0,0,0,0.15);
        }

        /* Grid covers the background image completely */
        .overlay-grid {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: grid;
            grid-template-columns: repeat(4, 1fr); /* 4 columns */
            grid-template-rows: repeat(4, 1fr);    /* 4 rows (16 blocks total) */
        }

        /* The blocks hiding the image */
        .block {
            background-color: #2c3e50;
            border: 1px solid #34495e;
            transition: opacity 0.5s ease;
            opacity: 1;
        }

        /* Hidden blocks scale down and fade out */
        .block.revealed {
            opacity: 0;
            pointer-events: none;
        }

        .reveal-btn {
            margin-top: 20px;
            padding: 12px 24px;
            font-size: 16px;
            background-color: #007bff;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            text-decoration: none;
            font-weight: bold;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        }

        .reveal-btn:hover {
            background-color: #0056b3;
        }

        #status-message {
            margin-top: 15px;
            font-weight: bold;
            color: #27ae60;
        }
    </style>
</head>
<body>

    <h1>🔍 What's the Mystery Picture?</h1>
    
    <div class="image-container">
        <div class="overlay-grid" id="grid"></div>
    </div>

    <!-- The interactive link styled like a button -->
    <a href="#" class="reveal-btn" id="reveal-link">Click to Reveal 1 Piece!</a>
    
    <p id="status-message"></p>

    <script>
        const gridContainer = document.getElementById('grid');
        const revealLink = document.getElementById('reveal-link');
        const statusMessage = document.getElementById('status-message');
        
        const TOTAL_BLOCKS = 16; // 4x4 grid
        
        // 1. Generate the grid blocks dynamically
        for (let i = 0; i < TOTAL_BLOCKS; i++) {
            const block = document.createElement('div');
            block.classList.add('block');
            gridContainer.appendChild(block);
        }

        // 2. Click event handler
        revealLink.addEventListener('click', function(event) {
            event.preventDefault(); // Prevents the page from jumping or reloading
            
            // Get all blocks that are still visible
            const hiddenBlocks = document.querySelectorAll('.block:not(.revealed)');
            
            if (hiddenBlocks.length > 0) {
                // Pick a random block from the remaining hidden ones
                const randomIndex = Math.floor(Math.random() * hiddenBlocks.length);
                hiddenBlocks[randomIndex].classList.add('revealed');
                
                // Update status tracking
                const remaining = hiddenBlocks.length - 1;
                if (remaining === 0) {
                    statusMessage.innerText = "🎉 The picture is fully revealed!";
                    revealLink.style.display = 'none';
                } else {
                    statusMessage.innerText = `${remaining} pieces left to uncover.`;
                }
            }
        });
    </script>
</body>
</html>
